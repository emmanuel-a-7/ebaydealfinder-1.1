# Discord Webhook URL for notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Scan interval in minutes (5-15 recommended for eBay)
SCAN_INTERVAL_MINUTES=10

# Maximum price in USD (including shipping)
MAX_PRICE=250

# Search query
SEARCH_QUERY=nvidia rtx 3060 12gb

# Set to true for first run testing (no Discord messages sent)
DRY_RUN=false
